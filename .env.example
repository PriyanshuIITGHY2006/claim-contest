# Copy to .env and fill in. Never commit .env.

# LLM provider (only if the app makes model calls)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Database (SQLite default; set for Supabase/Postgres)
DATABASE_URL=sqlite:///./app.db
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Service URLs
DATA_DIR=../data
BACKEND_URL=http://localhost:8000
AGENT_URL=http://localhost:8100
# scripted = replay expected verdicts (no LLM); llm = real agent
AGENT_MODE=scripted

# Frontend → backend and agent
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AGENT_URL=http://localhost:8100
